# Dati bancari reali: mai versionati (privacy, vincolo CLAUDE.md)
/data/
!/data/.gitkeep

# Output generati
/output/
!/output/.gitkeep

# Artefatti modello ML (versionati altrove: MLflow/registry)
/models/
/mlruns/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Ambiente
.env
*.local

# IaC / stato
*.tfstate
*.tfstate.*
.terraform/

# kubeconfig generato dal provider kind (contiene certificati/chiavi del cluster)
/infra/cashato-config
/infra/*-config

# Sealed Secrets pinned sealing key (SECRET ZERO — back up out-of-band, never commit)
infra/secrets/

# Out-of-band Tofu secrets (secret-zero)
infra/*.auto.tfvars

# frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# setuptools debris from a non-editable pip install
build/
