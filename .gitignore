# Real bank statements: never versioned (privacy)
/data/

# Generated output
/output/

# ML model artifacts (versioned elsewhere: MLflow/registry)
/models/
/mlruns/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
# ruff writes a self-ignoring .ruff_cache/.gitignore, so this is belt-and-braces
# — but `make clean` treats all three caches alike and so should this file.
.ruff_cache/

# Environment
.env
*.local

# IaC / state
*.tfstate
*.tfstate.*
.terraform/

# kubeconfig generated by the kind provider (holds the cluster's certs/keys)
/infra/cashato-config
/infra/*-config

# Sealed Secrets pinned sealing key (SECRET ZERO — back up out-of-band, never commit)
infra/secrets/

# Out-of-band Tofu secrets (secret-zero)
infra/*.auto.tfvars

# frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# macOS Finder debris
.DS_Store

# Claude Code per-machine state. Until now these were only ignored by the
# author's global gitconfig and .git/info/exclude — neither of which travels
# with a clone, so anyone else checking the repo out saw them as untracked.
# A shared .claude/settings.json stays versionable; the local ones do not.
.claude/settings.local.json
.claude/*.lock

# setuptools debris from a non-editable pip install
build/
