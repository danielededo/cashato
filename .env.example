# Copy to .env and adapt. Do NOT commit .env (it holds local configuration).

# Database (default: the docker-compose Postgres)
DATABASE_URL=postgresql+psycopg://cashato:cashato@localhost:5432/cashato

# Ollama (offline LLM labeling, ML phase)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding model for the classifier (sentence-transformers)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
