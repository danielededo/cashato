# Copia in .env e adatta. NON committare .env (contiene configurazione locale).

# Database (default: Postgres di docker-compose)
DATABASE_URL=postgresql+psycopg://cashato:cashato@localhost:5432/cashato

# Ollama (etichettatura LLM offline, fase ML)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Modello di embedding per il classificatore (sentence-transformers)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
