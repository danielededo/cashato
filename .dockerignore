# Keep the Docker build context small and free of secrets/bank data.
# Images need only: pyproject.toml, README.md, src/, alembic.ini, docker/,
# models/latest.joblib (train). Everything below is excluded.
.venv/
.git/
data/
output/
mlruns/
# frontend source IS needed by docker/Dockerfile.frontend — exclude only its build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
infra/
k8s/
tests/
.claude/
# README screenshots and the synthetic statements: no Dockerfile copies
# either, and together they are 1.3 MB of context per image build.
docs/
demo/
