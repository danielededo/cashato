# Shared service image (ingest-api, etl-worker, query-api, categorizer).
# The specific command is set by k8s (uvicorn cashato.services.<svc>.app:app or
# python -m cashato.services.<svc>.worker). config/*.yaml is NOT baked — it is a
# runtime ConfigMap mounted at CASHATO_CONFIG_DIR.
FROM python:3.14-slim

WORKDIR /app

# Minimal system deps for pdfplumber
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjpeg62-turbo libopenjp2-7 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir '.[svc]'

# Do not write .pyc at runtime: the root filesystem is mounted read-only in the
# cluster, and pip already byte-compiled everything at build time.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Run as a non-root UID. The etl-worker parses UNTRUSTED uploaded PDFs through
# pdfplumber/pdfminer — a historically CVE-bearing surface — so it should not be
# root with a writable filesystem. Numeric so runAsNonRoot can verify it without
# resolving a name. Nothing is written outside /tmp, which the Deployment mounts
# as an emptyDir.
USER 1000
