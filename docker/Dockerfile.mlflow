# MLflow tracking server + model registry (C6). The official mlflow image lacks
# the Postgres driver and S3 client, so add them: psycopg2 for the CNPG backend
# store, boto3 for the MinIO (S3) artifact store. The server command is set in the
# Deployment.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    mlflow==2.19.0 \
    psycopg2-binary==2.9.10 \
    boto3==1.35.99

EXPOSE 5000
