# Lightweight image for running Alembic migrations as a one-shot Job.
# Kept separate from Dockerfile.svc so the service images stay free of alembic.
# The .[migrate] extra pulls alembic (SQLAlchemy/psycopg are in the base deps);
# alembic.ini's script_location points at the packaged migrations under src/.
FROM python:3.14-slim

# git is for the CI control plane, not the migrator: the bump-deploy Task runs
# on this image and pushes the SHA pins to cashato-deploy. Baked in so the Task
# has no runtime apt-get — that needed the network AND root; this image runs
# as USER 1000.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
RUN pip install --no-cache-dir '.[migrate]'

# Do not write .pyc at runtime: the root filesystem is mounted read-only in the
# cluster, and pip already byte-compiled everything at build time.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Non-root: the migrator only reads the repo and talks to Postgres, so it has no
# reason to be root. Numeric UID so runAsNonRoot can verify it without resolving
# a name against /etc/passwd.
USER 1000
