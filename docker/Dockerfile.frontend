# Frontend SPA (phase E) — multi-stage: build the React/Vite bundle, then serve it
# as static files with hardened, non-root nginx. The gateway path-splits (`/api/v1`
# → APIs, `/` → here), so nginx only serves files + the SPA fallback — it does NOT
# proxy the API. Build context = repo root (see .dockerignore); frontend source is
# under frontend/.
FROM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build   # tsc --noEmit + vite build → /app/dist (the CI compile gate)

# nginx-unprivileged: listens on 8080 as UID 101; pairs with a read-only root FS
# (writable dirs are mounted as emptyDir in the Deployment securityContext).
# Fully-qualified: buildah runs short-name-mode=enforcing (unlike docker) and can't
# resolve a namespaced short name without a TTY.
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
